<winuiex:WindowEx x:Class="MelonGUI.MainWindow"
    xmlns:winuiex="using:WinUIEx"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Melon" Width="1040" Height="800" MinWidth="640" MinHeight="480">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <NavigationView x:Name="Sidebar" PaneDisplayMode="Auto" OpenPaneLength="224"
                        ExpandedModeThresholdWidth="850" CompactModeThresholdWidth="550"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Navigate">
            <Grid Padding="28,22,28,20" MaxWidth="1100" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Heading" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                <InfoBar x:Name="ConnectionBar" Grid.Row="1" Severity="Warning" IsClosable="False"/>
                <InfoBar x:Name="Feedback" Grid.Row="2" IsClosable="True"/>
                <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <ContentControl x:Name="Body" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="0,4,4,12"/>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</winuiex:WindowEx>
